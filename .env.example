# API Sentinel Configuration

# Database
DATABASE_URL=sqlite:///./api_sentinel.db

# Server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# Credential fingerprinting (HMAC-SHA256 key, >= 32 chars; generate with
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Unset or shorter => fingerprinting off, client IP is the actor.
SENTINEL_FP_SECRET=

# Admin key for Sentinel's own API, sent as X-Sentinel-Key (>= 32 chars).
# Unset => reads open (dev only), POST /api/scan and PATCH /api/alerts disabled.
SENTINEL_API_KEY=

# Phase 3/4 (optional JSON files; see docs/GATEWAY_AND_RATE_LIMITS.md).
# Per-endpoint limits/window; unset => built-in defaults (60 s window).
SENTINEL_RATE_LIMITS_PATH=
# Principals (credential fingerprints -> user/vp). Unset => nobody gets the VP quota.
SENTINEL_PRINCIPALS_PATH=
# Gateway upstream + route allowlist; unset => /gateway/* is not mounted.
SENTINEL_GATEWAY_CONFIG=
# Latest evaluation result (JSON). Unset => evaluation-latest.json next to the database file.
SENTINEL_EVALUATION_PATH=

# API Traffic Capture
ENABLE_CAPTURE=True
CAPTURE_SAMPLE_RATE=1.0

# Detection
ENABLE_SHADOW_DETECTION=True
ENABLE_ABUSE_DETECTION=True

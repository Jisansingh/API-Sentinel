# API Sentinel Configuration

# Database
DATABASE_URL=sqlite:///./api_sentinel.db

# Server
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# API Traffic Capture
ENABLE_CAPTURE=True
CAPTURE_SAMPLE_RATE=1.0

# Detection
ENABLE_SHADOW_DETECTION=True
ENABLE_ABUSE_DETECTION=True

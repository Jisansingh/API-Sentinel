# Template for scripts/run-local.sh. Copy it OUTSIDE the repository, fill it in, chmod 600:
#   cp docs/examples/local.env.example ~/sentinel-local.env && chmod 600 ~/sentinel-local.env
# Generate each secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the filled-in file.

SENTINEL_API_KEY=
SENTINEL_FP_SECRET=
# Absolute path (four slashes). Use a NEW file for testing; never the live database.
DATABASE_URL=sqlite:////ABSOLUTE/PATH/TO/sentinel-test.db

BACKEND_PORT=9101
DASHBOARD_PORT=9102
SENTINEL_ENV=development

# Optional Phase 3/4 configuration (absolute paths). Leave empty to keep them off:
# gateway off, nobody gets the VP quota, built-in per-endpoint limits.
SENTINEL_GATEWAY_CONFIG=
SENTINEL_PRINCIPALS_PATH=
SENTINEL_RATE_LIMITS_PATH=
OPENAPI_SPEC_PATH=
# Only if a reverse proxy in front of uvicorn overwrites X-Forwarded-For, e.g. 127.0.0.1:
TRUST_PROXY_IPS=
# Deliberately vulnerable demo shop that "Generate sample traffic" calls (/shop/*).
# On for the local demo; it is refused when SENTINEL_ENV=production (set it to false there).
ENABLE_DEMO_TARGET=true
